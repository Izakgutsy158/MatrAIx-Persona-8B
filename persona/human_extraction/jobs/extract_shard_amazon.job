#!/bin/bash
#SBATCH -p seas_gpu
#SBATCH --gres=gpu:nvidia_a100-sxm4-80gb:2
#SBATCH -n 1
#SBATCH -c 32
#SBATCH --mem=160G
#SBATCH -t 2-00:00
#SBATCH -o sbatch_logs/%x_%A_%a.out
#SBATCH -e sbatch_logs/%x_%A_%a.err
#
# Amazon persona extraction — one array task = one user_bucket.
# 256 buckets (00..ff), ~390 selected users each. shard-id == array index maps to
# the hex bucket. Default profile is 2x A100 80GB in full bf16. For 8x24GB
# machines, request an 8-GPU allocation and set GPU_CONFIG=8x24g.
#
#   cd persona/human_extraction/jobs
#   mkdir -p sbatch_logs
#   sbatch --array=0-255%16 extract_shard_amazon.job          # full run
#   sbatch --array=0%1 --export=ALL,LIMIT=8 extract_shard_amazon.job  # smoke test
#   sbatch -p <partition> --gres=gpu:8 -c 64 --mem=256G --array=0%1 \
#       --export=ALL,GPU_CONFIG=8x24g,LIMIT=6 extract_shard_amazon.job
#
# Resumable: run_extraction_amazon.py appends to shard_<bkt>.jsonl and skips
# user_id already written; re-run the same sbatch line to top up unfinished shards.

set -uo pipefail

mamba init >/dev/null 2>&1 || true
module load python/3.10.13-fasrc01
module load cuda/12.4.1-fasrc01
conda activate env05

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
PY="python"

# --- caches on netscratch (never home) ---
export HF_HOME="${SCRATCH:-/tmp}/matraix_cache/hf_home"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_XET_CACHE="$HF_HOME/xet"
export VLLM_CACHE_ROOT="${SCRATCH:-/tmp}/matraix_cache/vllm"
export VLLM_WORKER_MULTIPROC_METHOD=spawn
mkdir -p "$VLLM_CACHE_ROOT" sbatch_logs

SHARD_ID="${SLURM_ARRAY_TASK_ID:-${SHARD_ID:-0}}"
OUT_DIR="${OUT_DIR:-$REPO_ROOT/persona/human_extraction/data/amazon/extraction_v1}"
LIMIT="${LIMIT:-0}"
GPU_CONFIG="${GPU_CONFIG:-a100_2x80_bf16}"

case "$GPU_CONFIG" in
    a100_2x80_bf16)
        TP="${TP:-2}"
        QUANT="${QUANT:-none}"
        GPU_MEM="${GPU_MEM:-0.90}"
        MAX_NUM_SEQS="${MAX_NUM_SEQS:-64}"
        BATCH_PROFILES="${BATCH_PROFILES:-32}"
        ;;
    8x24g)
        TP="${TP:-8}"
        QUANT="${QUANT:-none}"
        GPU_MEM="${GPU_MEM:-0.88}"
        MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
        BATCH_PROFILES="${BATCH_PROFILES:-8}"
        ;;
    *)
        echo "Unsupported GPU_CONFIG=$GPU_CONFIG (expected a100_2x80_bf16 or 8x24g)" >&2
        exit 2
        ;;
esac

echo "=== amazon persona extraction shard ==="
echo "date=$(date -Is)  host=$(hostname)"
echo "shard_id=$SHARD_ID  bucket=$(printf '%02x' "$SHARD_ID")  out_dir=$OUT_DIR"
echo "gpu_config=$GPU_CONFIG  tp=$TP  quant=$QUANT  gpu_mem=$GPU_MEM  max_num_seqs=$MAX_NUM_SEQS  batch_profiles=$BATCH_PROFILES  limit=$LIMIT"
echo "slurm_job=${SLURM_JOB_ID:-none}  array_task=${SLURM_ARRAY_TASK_ID:-none}"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader | head -"$TP"

cd "$REPO_ROOT"
start=$(date +%s)
"$PY" -u persona/human_extraction/scripts/run_extraction_amazon.py \
    --shard-id "$SHARD_ID" \
    --out-dir "$OUT_DIR" \
    --batch-profiles "$BATCH_PROFILES" \
    --tensor-parallel "$TP" \
    --quantization "$QUANT" \
    --gpu-mem "$GPU_MEM" \
    --max-num-seqs "$MAX_NUM_SEQS" \
    --limit "$LIMIT"
rc=$?
echo "DONE shard=$SHARD_ID rc=$rc elapsed=$(( $(date +%s) - start ))s"
exit $rc
