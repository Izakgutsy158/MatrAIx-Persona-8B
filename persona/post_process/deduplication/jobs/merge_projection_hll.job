#!/bin/bash
#SBATCH -p seas_compute
#SBATCH -n 1
#SBATCH -c 1
#SBATCH --mem=8G
#SBATCH -t 0-01:00
#SBATCH -o sbatch_logs/%x_%j.out
#SBATCH -e sbatch_logs/%x_%j.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}"
PYTHON_BIN="${PYTHON_BIN:-python}"
CONFIG="${CONFIG:?CONFIG is required}"
OUTPUT_DIR="${OUTPUT_DIR:?OUTPUT_DIR is required}"
SUMMARY_OUT="${SUMMARY_OUT:?SUMMARY_OUT is required}"
TARGET_ROWS="${TARGET_ROWS:-8397735907}"

cd "$REPO_ROOT"
PYTHONPATH="$REPO_ROOT" "$PYTHON_BIN" \
  persona/post_process/deduplication/merge_projection_hll.py \
  --input-dir "$OUTPUT_DIR" \
  --config "$CONFIG" \
  --target-rows "$TARGET_ROWS" \
  --out "$SUMMARY_OUT"